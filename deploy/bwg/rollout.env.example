# Copy to rollout.env (not committed) and adjust for this host. rollout.sh sources
# it; anything here can also be overridden from the environment for one run.

# nginx vhost files that proxy to 9router (space-separated). Required.
SITES="/etc/nginx/sites-available/9router.example.com /etc/nginx/sites-available/9router-2.example.com"

# Where run logs and the nginx backups taken by `migrate` go.
LOG_DIR=/var/log/9router-rollout

# Optional, with their defaults:
# UPSTREAM_CONF=/etc/nginx/conf.d/9router-upstream.conf   # must be included before the vhosts
# VOL=9router_9router-data                                # the compose data volume
# IMAGE=9router:local
# SLOT_NET=9router-slots  SLOT_SUBNET=172.31.9.0/24  BLUE_IP=172.31.9.20  GREEN_IP=172.31.9.21
# DRAIN_TIMEOUT=1500  SETTLE=5
# LEGACY=9router  LEGACY_PORT=20128                       # only used by the one-time `migrate`
